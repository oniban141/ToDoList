<Window x:Class="DailyPlanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DailyPlanner.Views"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Ежедневник" Height="768" Width="1024" WindowState="Maximized"
        x:Name="MainWindowRoot">
    <Window.Resources>
        <Color x:Key="PrimaryColor">#D12128</Color>
        <Color x:Key="SecondaryColor">#01344F</Color>
        <Color x:Key="AccentColor">#FAE3AC</Color>
        
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="LightBackground" Color="White"/>
        <SolidColorBrush x:Key="DarkBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="LightText" Color="Black"/>
        <SolidColorBrush x:Key="DarkText" Color="White"/>
        
        <!-- Light Theme Styles -->
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="LightTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="LightDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <!-- Dark Theme Styles -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>
    
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkBackground}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                    <Setter Property="Background" Value="{StaticResource LightBackground}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1,0,1,0" Background="{StaticResource SecondaryColor}">
            <StackPanel Margin="10" VerticalAlignment="Stretch">
                <!-- User Info -->
                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentUser.Username}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding CurrentUser.Email}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Theme Toggle -->
                <Button Content="🌙 Сменить тему" Command="{Binding ToggleThemeCommand}" 
                        Style="{StaticResource DarkButton}" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>
                
                <!-- Calendar -->
                <TextBlock Text="Календарь" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding FilterDueDate, Mode=TwoWay}" 
                          Style="{StaticResource DarkDatePicker}" 
                          HorizontalAlignment="Stretch" Margin="0,0,0,20"/>
                
                <!-- Search -->
                <TextBlock Text="Поиск" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource DarkTextBox}" 
                        PlaceholderText="Введите запрос..." Margin="0,0,0,20"/>
                
                <!-- Filters -->
                <TextBlock Text="Фильтры" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                
                <ComboBox ItemsSource="{Binding Source={x:Static local:MainWindow.StatusValues}}" 
                         SelectedValue="{Binding FilterStatus, Mode=TwoWay}" 
                         Style="{StaticResource DarkTextBox}" 
                         Margin="0,0,0,10" 
                         PlaceholderText="Статус"/>
                
                <ComboBox ItemsSource="{Binding Source={x:Static local:MainWindow.PriorityValues}}" 
                         SelectedValue="{Binding FilterPriority, Mode=TwoWay}" 
                         Style="{StaticResource DarkTextBox}" 
                         Margin="0,0,0,10" 
                         PlaceholderText="Приоритет"/>
                
                <!-- Navigation -->
                <Expander Header="Навигация" Foreground="White" Margin="0,10,0,0">
                    <StackPanel>
                        <Button Content="📋 Задачи" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="📅 События" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="📝 Заметки" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="🏷️ Теги" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="⏰ Напоминания" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                    </StackPanel>
                </Expander>
                
                <!-- Export/Import -->
                <Expander Header="Экспорт/Импорт" Foreground="White" Margin="0,10,0,0">
                    <StackPanel>
                        <Button Content="📤 JSON" Command="{Binding ExportToJsonCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="📥 JSON" Command="{Binding ImportFromJsonCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="📤 CSV" Command="{Binding ExportToCsvCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                        <Button Content="📥 CSV" Command="{Binding ImportFromCsvCommand}" Style="{StaticResource DarkButton}" Margin="0,2,0,2"/>
                    </StackPanel>
                </Expander>
                
                <!-- Exit -->
                <Button Content="🚪 Выход" Command="{Binding ExitCommand}" Style="{StaticResource DarkButton}" HorizontalAlignment="Stretch" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Dashboard -->
            <Border Grid.Row="0" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <TextBlock Text="Дашборд" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
            </Border>
            
            <!-- Charts -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Статусы задач" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                        <lvc:PieChart Series="{Binding TaskStatusChartSeries}" Height="200"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Приоритеты задач" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart Series="{Binding TaskPriorityChartSeries}" Height="200">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Приоритет" Labels="Low,Medium,High"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Количество"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Tabs for different views -->
            <TabControl Grid.Row="2">
                <!-- Tasks Tab -->
                <TabItem Header="📋 Задачи">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="➕ Добавить" Command="{Binding AddTaskCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="✏️ Изменить" Command="{Binding UpdateTaskCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🗑️ Удалить" Command="{Binding DeleteTaskCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="➕ Напоминание" Command="{Binding AddReminderCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" 
                                 Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="Auto"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                
                <!-- Events Tab -->
                <TabItem Header="📅 События">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="➕ Добавить" Command="{Binding AddEventCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="✏️ Изменить" Command="{Binding UpdateEventCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🗑️ Удалить" Command="{Binding DeleteEventCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" 
                                 Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto"/>
                                <DataGridTextColumn Header="Конец" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto"/>
                                <DataGridTextColumn Header="Место" Binding="{Binding Location}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                
                <!-- Notes Tab -->
                <TabItem Header="📝 Заметки">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="➕ Добавить" Command="{Binding AddNoteCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="✏️ Изменить" Command="{Binding UpdateNoteCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🗑️ Удалить" Command="{Binding DeleteNoteCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" 
                                 Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Содержание" Binding="{Binding Content}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                
                <!-- Tags Tab -->
                <TabItem Header="🏷️ Теги">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="➕ Добавить" Command="{Binding AddTagCommand}" Style="{StaticResource DarkButton}" Margin="0,0,5,0"/>
                            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" 
                                 Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                
                <!-- Reminders Tab -->
                <TabItem Header="⏰ Напоминания">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Reminders}" 
                                 Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                                <DataGridTextColumn Header="Задача" Binding="{Binding TaskTitle}" Width="*"/>
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                                <DataGridTextColumn Header="Время" Binding="{Binding ReminderTime, StringFormat=dd.MM.yyyy HH:mm}" Width="Auto"/>
                                <DataGridTextColumn Header="Активен" Binding="{Binding IsActive}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>

<!-- Separate DatePicker style definition -->
<Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">
    <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="5"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="FontSize" Value="12"/>
</Style>
